{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "tsconfig/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "jest", "@testing-library/jest-dom", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@dt-dds/react": ["../../packages/dt-dds-react/index.ts"],
      "@dt-dds/themes": ["../../packages/themes/src/index.ts"],
      "@dt-dds/react-*": ["../../packages/react-packages/*/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    ".storybook/**/*",
    "../../packages/react-packages/*/src/**/*"
  ]
}
