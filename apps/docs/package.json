{
  "name": "@dt-dds/docs",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "storybook build --docs",
    "clean": "rm -rf .turbo && rm -rf node_modules",
    "dev": "storybook dev -p 6006",
    "lint": "eslint --cache .",
    "test-storybook": "vitest run --project=storybook",
    "test-storybook:ci": "yarn test-storybook --reporter=default --reporter=json --outputFile=test-results/storybook.json",
    "preview-storybook": "vite storybook-static",
    "vrt": "node vrt/run.mts",
    "vrt:update": "node vrt/run.mts --update"
  },
  "dependencies": {
    "@emotion/css": "^11.7.1",
    "@emotion/react": "^11.8.2",
    "@emotion/styled": "^11.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-links": "10.6.2",
    "@storybook/addon-mcp": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint-config-custom": "*",
    "eslint-plugin-storybook": "10.6.2",
    "playwright": "1.64.0",
    "storybook": "10.6.2",
    "tsconfig": "*",
    "typescript": "^5.9.3",
    "vite": "^8.2.4",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-tsconfig-paths": "^4.3.1",
    "vitest": "^5.0.4"
  }
}
