{
  "name": "@dt-dds/icons",
  "version": "1.0.0-beta.10",
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./index.css": "./src/index.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/**",
    "src/index.css",
    "src/fonts/**"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint --cache ."
  },
  "devDependencies": {
    "eslint-config-custom": "*",
    "eslint-plugin-storybook": "10.6.2",
    "tsconfig": "*",
    "tsup": "^8.5.0",
    "typescript": "^4.5.3"
  }
}
